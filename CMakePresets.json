{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/stage/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SIMPLEGRAPHIC_BUILD_TESTS": "ON",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets"
      }
    },
    {
      "name": "linux-x86",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32",
        "CMAKE_SHARED_LINKER_FLAGS": "-m32",
        "CMAKE_MODULE_LINKER_FLAGS": "-m32",
        "VCPKG_TARGET_TRIPLET": "x86-linux-dynamic"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "linux-arm64",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux-dynamic"
      }
    },
    {
      "name": "macos-x64",
      "inherits": "base",
      "environment": {
        "MACOSX_DEPLOYMENT_TARGET": "10.15"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15",
        "VCPKG_TARGET_TRIPLET": "x64-osx-dynamic"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "base",
      "environment": {
        "MACOSX_DEPLOYMENT_TARGET": "11.0"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic"
      }
    },
    {
      "name": "windows-x86",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows"
      }
    },
    {
      "name": "windows-x64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "ARM64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x86",
      "configurePreset": "linux-x86"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64"
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64"
    },
    {
      "name": "macos-x64",
      "configurePreset": "macos-x64"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-x86",
      "configurePreset": "linux-x86",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x64",
      "configurePreset": "macos-x64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
